                  "pm.test('signed in', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "if (pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('adminToken', body.token);",
                  "}"
                ]
