# On macOS, AirPlay Receiver uses port 5000; use 5001 locally (and update NEXT_PUBLIC_API_URL in notes-web).
PORT=5000
NODE_ENV=development
MONGO_URI=
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional: enables database tests in `npm test`. The database name must contain "test"; it is dropped after the run.
TEST_MONGO_URI=
# Optional: store images on Cloudinary (https://cloudinary.com, Dashboard -> API Keys).
# Without them, images are stored on this server in UPLOAD_DIR (default ./uploads) and served at /uploads.
# Use Cloudinary in production if the host's disk is wiped on redeploy (e.g. Render free).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# UPLOAD_DIR=./uploads
# Public URL of the web app (used in password reset emails).
APP_URL=http://localhost:3000
# Optional: SMTP for sending email (e.g. Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true,
# your Gmail address and an App Password). Without SMTP_HOST, emails are printed to the API
# console in development instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Notes <no-reply@notes.local>
